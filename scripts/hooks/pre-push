#!/bin/sh
# 推送前闸门：本仓文档存在 🔴（机器修不了的不一致）→ 拒绝推送
ROOT=$(git rev-parse --show-toplevel)
[ -f "$ROOT/scripts/docs-audit.js" ] || exit 0
command -v node >/dev/null 2>&1 || { echo "⚠️ 无 node，跳过文档闸门"; exit 0; }
out=$(cd "$ROOT" && node scripts/docs-audit.js --dry-run 2>&1)
if echo "$out" | grep -q '🔴'; then
  echo ""
  echo "⛔ 文档存在无法自动修复的不一致，已阻止推送："
  echo "$out" | grep '🔴' | sed 's/^/   /'
  echo "   → 处理后重推；确认无碍可 git push --no-verify"
  echo ""
  exit 1
fi
echo "✅ 推送前文档闸门：本仓无红项"
exit 0
